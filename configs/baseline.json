{
  "seed": 42,
  "dataset_root": "prompt injection dataset",
  "prepared_dir": "data/processed",
  "run_dir": "runs/baseline",
  "near_duplicate_jaccard": 0.85,
  "validation_folds": 5,
  "oof_folds": 5,
  "stacking_mode": "oof",
  "sources": [
    {
      "glob": "prompt-injections-benchmark/data/*.parquet",
      "text": "text",
      "label": "label",
      "mapping": {
        "benign": 0,
        "jailbreak": 1
      },
      "evidence": "Local README defines benign/jailbreak; jailbreak is a related proxy, not identical to prompt injection.",
      "split": "test"
    },
    {
      "glob": "prompt_injections/*.csv",
      "text": "prompt_injections",
      "constant_label": 1,
      "evidence": "Local README explicitly describes all rows as prompt injections."
    },
    {
      "glob": "memoryInjection/C.A.M.S/*.csv",
      "text": "query",
      "label": "label",
      "mapping": {
        "legitimate": 0
      },
      "category": "subcategory",
      "template_numbers": true,
      "evidence": "Literal legitimate label; ambiguous, mextra and minja remain quarantined pending documentation."
    },
    {
      "glob": "prompt-injections-benchmark/test.csv",
      "text": "text",
      "label": "label",
      "mapping": {
        "benign": 0,
        "jailbreak": 1
      },
      "evidence": "Same documented benchmark labels; audit revision conflicts only.",
      "split": "test",
      "audit_only": true
    }
  ],
  "tfidf": {
    "cv_folds": 3,
    "search": "compact",
    "max_iter": 2000,
    "n_jobs": 1
  },
  "transformer": {
    "batch_size": 4,
    "learning_rate": 2e-05,
    "epochs": 3,
    "max_length": 256,
    "weight_decay": 0.01,
    "patience": 2,
    "gradient_accumulation": 4,
    "warmup_ratio": 0.1,
    "mixed_precision": true,
    "max_grad_norm": 1.0,
    "class_weight": "auto",
    "num_threads": 4,
    "local_files_only": true,
    "cache_dir": ".cache/huggingface",
    "resume": true,
    "models": {
      "bert": "bert-base-uncased",
      "roberta": "FacebookAI/roberta-base",
      "distilbert": "distilbert-base-uncased"
    },
    "retain_optimizer_checkpoints": false
  }
}
